# Builds the working tree, for trying changes with bin/install. The release
# package for Omarchy is packaging/omarchy-pkgs/pkgbuilds/memo/PKGBUILD.
pkgname=memo
pkgver=0.1.0
pkgrel=1
pkgdesc='Record voice memos with one key, theme-synced for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/WilliamJohnDavisIII/memo'
license=('MIT')
install='memo.install'
options=('!debug')
depends=(
  'ffmpeg'
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia>=6.8'
  'qt6-multimedia-ffmpeg'
  'qt6-wayland'
)
optdepends=('superwhisper-bin: transcribe memos with T')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/memo "$pkgdir/usr/bin/memo"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/memo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/memo.svg"
  install -Dm644 pkgbuild/memo.desktop "$pkgdir/usr/share/applications/memo.desktop"
}
