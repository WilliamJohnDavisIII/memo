pkgname=memo
pkgver=0.1.0
pkgrel=1
pkgdesc='Record voice memos with one key'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-multimedia' 'qt6-multimedia-ffmpeg' 'ffmpeg')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/memo "$pkgdir/usr/bin/memo"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/memo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/memo.svg"
  install -Dm644 "$startdir/memo.desktop" "$pkgdir/usr/share/applications/memo.desktop"
}
